# OrderAPI — environment variables (all profiles)
# HTTP/local profile (DOTNET_RUNNING_IN_CONTAINER != true)

Http__ConnectionStrings__DefaultConnection=
Http__ServiceUrls__ProductAPI=

# Docker profile (DOTNET_RUNNING_IN_CONTAINER=true)
# DB: host.docker.internal → sqlserver (Compose service DNS name)
# ProductAPI: mango.services.productapi → mango-product (matches docker-compose container_name)

Docker__ConnectionStrings__DefaultConnection=
Docker__ServiceUrls__ProductAPI=

# Common settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
ApiSettings__Secret=
ApiSettings__Issuer=
ApiSettings__Audience=

# Initial provider. RabbitMQ queue mappings and dead-letter arguments are in appsettings.json.
MessageBus__Provider=RabbitMQ
MessageBus__RabbitMQ__HostName=
MessageBus__RabbitMQ__Port=5672
MessageBus__RabbitMQ__UserName=
MessageBus__RabbitMQ__Password=
MessageBus__RabbitMQ__VirtualHost=/

# To select Kafka instead, set MessageBus__Provider=Kafka and configure:
# MessageBus__Kafka__BootstrapServers=localhost:9092
# MessageBus__Kafka__ClientId=mango-orderapi
# MessageBus__Kafka__Destinations__OrderCreated=order-created
# Kafka support here publishes events; RewardAPI and EmailAPI consumers must also be migrated.
